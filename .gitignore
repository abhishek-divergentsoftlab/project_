# --- Secrets -----------------------------------------------------------------
# Never commit a real .env. Commit .env.example instead.
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node --------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.tsbuildinfo

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
*.swo

# --- Runtime state -----------------------------------------------------------
# User uploads (certificates, KYC, live captures) are data, not source.
# Already-tracked files stay tracked until: git rm -r --cached backend/uploads uploads
backend/uploads/
uploads/
.pids/
.logs/

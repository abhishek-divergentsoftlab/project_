# Left empty so requests go to the Vite dev proxy on the same origin.
# Set to an absolute URL (e.g. https://api.example.com/api/v1) for a deployed build.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api to.
VITE_PROXY_TARGET=http://127.0.0.1:8011

# =============================================================================
# Map & Geocoding API Keys (Optional in Development)
# Built-in fallback: CartoDB / OpenStreetMap works with 0 config and NO key needed.
# =============================================================================

# Mapbox Public Access Token (Recommended)
# Free Tier: 50,000 map loads/mo + 100,000 geocoding requests/mo free forever
# Get free key: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# Geoapify API Key (Alternative - No credit card required on signup)
# Free Tier: 3,000 requests/day (~90,000 requests/mo) free
# Get free key: https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# LocationIQ Access Token (Alternative)
# Free Tier: 5,000 requests/day free
# Get free key: https://locationiq.com/
VITE_LOCATIONIQ_API_KEY=

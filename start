#!/usr/bin/env bash

# Resolve project root directory safely (handling symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$PROJECT_DIR"

mkdir -p "$PROJECT_DIR/.pids" "$PROJECT_DIR/.logs"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}====================================================${NC}"
echo -e "${BLUE}         Starting B2B Marketplace Services          ${NC}"
echo -e "${BLUE}====================================================${NC}"

# 1. Backing Services (Docker Compose: PostgreSQL, Qdrant, Redis)
if command -v docker &>/dev/null && [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
    echo -e "${YELLOW}[*] Starting Docker backing services (Postgres, Qdrant, Redis)...${NC}"
    docker compose -f "$PROJECT_DIR/docker-compose.yml" up -d
    echo -e "${GREEN}[✓] Docker services are up.${NC}"
else
    echo -e "${YELLOW}[!] Docker not found or docker-compose.yml missing. Skipping containers.${NC}"
fi

# 2. Backend Service (Port 8011)
BACKEND_PID_FILE="$PROJECT_DIR/.pids/backend.pid"
BACKEND_RUNNING=false

if [ -f "$BACKEND_PID_FILE" ] && kill -0 "$(cat "$BACKEND_PID_FILE")" 2>/dev/null; then
    BACKEND_RUNNING=true
elif lsof -ti :8011 &>/dev/null; then
    BACKEND_RUNNING=true
fi

if [ "$BACKEND_RUNNING" = true ]; then
    echo -e "${GREEN}[✓] Backend is already running on port 8011.${NC}"
else
    echo -e "${YELLOW}[*] Starting Backend service on http://127.0.0.1:8011...${NC}"
    VENV_PYTHON="$PROJECT_DIR/backend/.venv/bin/python"
    VENV_UVICORN="$PROJECT_DIR/backend/.venv/bin/uvicorn"

    if [ ! -x "$VENV_UVICORN" ]; then
        echo -e "${YELLOW}[*] Creating Python virtual environment in backend/.venv...${NC}"
        python3 -m venv "$PROJECT_DIR/backend/.venv"
        "$PROJECT_DIR/backend/.venv/bin/pip" install -r "$PROJECT_DIR/backend/requirements.txt"
    fi

    BACKEND_LOG="$PROJECT_DIR/.logs/backend.log"
    # Append, never truncate: the migration output below and earlier runs'
    # tracebacks must survive the server start.
    echo "===== backend start $(date '+%Y-%m-%d %H:%M:%S') =====" >> "$BACKEND_LOG"

    # Run database migrations
    if [ -x "$PROJECT_DIR/backend/.venv/bin/alembic" ]; then
        echo -e "${YELLOW}[*] Applying database migrations...${NC}"
        if ! (cd "$PROJECT_DIR/backend" && .venv/bin/alembic upgrade head >> "$BACKEND_LOG" 2>&1); then
            echo -e "${RED}[!] Database migration failed -- see $BACKEND_LOG${NC}"
        fi
    fi

    (
        cd "$PROJECT_DIR/backend"
        nohup "$VENV_UVICORN" app:app --reload --port 8011 >> "$BACKEND_LOG" 2>&1 &
        echo $! > "$BACKEND_PID_FILE"
    )
    echo -e "${GREEN}[✓] Backend service started (PID: $(cat "$BACKEND_PID_FILE")).${NC}"
fi

# 3. Frontend Service (Port 5175)
FRONTEND_PID_FILE="$PROJECT_DIR/.pids/frontend.pid"
FRONTEND_RUNNING=false

if [ -f "$FRONTEND_PID_FILE" ] && kill -0 "$(cat "$FRONTEND_PID_FILE")" 2>/dev/null; then
    FRONTEND_RUNNING=true
elif lsof -ti :5175 &>/dev/null; then
    FRONTEND_RUNNING=true
fi

if [ "$FRONTEND_RUNNING" = true ]; then
    echo -e "${GREEN}[✓] Frontend is already running on port 5175.${NC}"
else
    echo -e "${YELLOW}[*] Starting Frontend service on http://localhost:5175...${NC}"
    if [ ! -d "$PROJECT_DIR/frontend/node_modules" ]; then
        echo -e "${YELLOW}[*] Installing frontend dependencies (npm install)...${NC}"
        (cd "$PROJECT_DIR/frontend" && npm install >> "$PROJECT_DIR/.logs/frontend.log" 2>&1)
    fi

    (
        cd "$PROJECT_DIR/frontend"
        nohup npm run dev > "$PROJECT_DIR/.logs/frontend.log" 2>&1 &
        echo $! > "$FRONTEND_PID_FILE"
    )
    echo -e "${GREEN}[✓] Frontend service started (PID: $(cat "$FRONTEND_PID_FILE")).${NC}"
fi

# 4. Wait briefly and report status
echo -e "${YELLOW}[*] Verifying services...${NC}"
sleep 2

echo -e "\n${BLUE}====================================================${NC}"
echo -e "${GREEN}        Services Started & Ready to Use!            ${NC}"
echo -e "${BLUE}====================================================${NC}"
echo -e "  Frontend URL:     ${GREEN}http://localhost:5175${NC}"
echo -e "  Backend API:      ${GREEN}http://127.0.0.1:8011${NC}"
echo -e "  API Docs (Swagger):${GREEN}http://127.0.0.1:8011/docs${NC}"
echo -e "  API Health Check: ${GREEN}http://127.0.0.1:8011/api/v1/health${NC}"
echo -e "  Backend Log:      $PROJECT_DIR/.logs/backend.log"
echo -e "  Frontend Log:     $PROJECT_DIR/.logs/frontend.log"
echo -e "${BLUE}====================================================${NC}\n"

# Desktop notification if supported
if command -v notify-send &>/dev/null && { [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; }; then
    notify-send "B2B Marketplace" "Services started successfully!\nFrontend: http://localhost:5175\nBackend: http://127.0.0.1:8011" 2>/dev/null || true
fi

#!/usr/bin/env bash

# Resolve project root directory safely (handling symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$PROJECT_DIR"

mkdir -p "$PROJECT_DIR/.pids" "$PROJECT_DIR/.logs"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}====================================================${NC}"
echo -e "${BLUE}         Starting B2B Marketplace Services          ${NC}"
echo -e "${BLUE}====================================================${NC}"

# 1. Backing Services (Docker Compose: PostgreSQL, Qdrant, Redis)
if command -v docker &>/dev/null && [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
    echo -e "${YELLOW}[*] Starting Docker backing services (Postgres, Qdrant, Redis)...${NC}"
    docker compose -f "$PROJECT_DIR/docker-compose.yml" up -d
    echo -e "${GREEN}[✓] Docker services are up.${NC}"
else
    echo -e "${YELLOW}[!] Docker not found or docker-compose.yml missing. Skipping containers.${NC}"
fi

# 2. vLLM Inference Engine (Port 8001)
VLLM_PID_FILE="$PROJECT_DIR/.pids/vllm.pid"
VLLM_RUNNING=false

if [ -f "$VLLM_PID_FILE" ] && kill -0 "$(cat "$VLLM_PID_FILE")" 2>/dev/null; then
    VLLM_RUNNING=true
elif lsof -ti :8001 &>/dev/null; then
    VLLM_RUNNING=true
fi

RUN_VLLM=false
if grep -q "^LLM_PROVIDER=vllm" "$PROJECT_DIR/backend/.env" 2>/dev/null; then
    RUN_VLLM=true
fi

if [ "$RUN_VLLM" = true ]; then
    if [ "$VLLM_RUNNING" = true ]; then
        echo -e "${GREEN}[✓] vLLM engine is already running on port 8001.${NC}"
    else
        VLLM_BIN="/home/divergent/miniconda3/bin/vllm"
        if [ -x "$VLLM_BIN" ]; then
            echo -e "${YELLOW}[*] Starting vLLM engine on http://127.0.0.1:8001 (GPU acceleration)...${NC}"
            VLLM_LOG="$PROJECT_DIR/.logs/vllm.log"
            echo "===== vllm start $(date '+%Y-%m-%d %H:%M:%S') =====" >> "$VLLM_LOG"
            (
                export PYTHONOPTIMIZE=1
                export HF_HUB_OFFLINE=1
                export VLLM_NO_USAGE_STATS=1
                nohup "$VLLM_BIN" serve Qwen/Qwen3-8B \
                    --host 127.0.0.1 \
                    --port 8001 \
                    --gpu-memory-utilization 0.15 \
                    --max-model-len 8192 \
                    --enforce-eager >> "$VLLM_LOG" 2>&1 &
                echo $! > "$VLLM_PID_FILE"
            )
            echo -e "${GREEN}[✓] vLLM service started in background (PID: $(cat "$VLLM_PID_FILE")).${NC}"
        else
            echo -e "${YELLOW}[!] vLLM binary not found at $VLLM_BIN. Backend will use Ollama fallback.${NC}"
        fi
    fi
else
    CHAT_MODEL="$(grep -E '^AI_CHAT_MODEL=' "$PROJECT_DIR/backend/.env" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ')"
    CHAT_MODEL="${CHAT_MODEL:-gpt-oss:120b}"
    echo -e "${GREEN}[✓] AI Chat configured to use Ollama with ${CHAT_MODEL} (vLLM idle).${NC}"
fi

# 2b. Ollama GPU guard: make sure the chat model is fully on the GPU (not split onto the CPU by a full page cache).
# Runs in the background (a cold load takes 20-45 s) and only when Ollama answers.
if ! grep -q "^LLM_PROVIDER=vllm" "$PROJECT_DIR/backend/.env" 2>/dev/null; then
    OLLAMA_URL="$(grep -E '^OLLAMA_BASE_URL=' "$PROJECT_DIR/backend/.env" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ')"
    OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
    OLLAMA_UP=false
    for _ in 1 2 3 4 5; do
        if curl -fs -m 2 "$OLLAMA_URL/api/version" >/dev/null 2>&1; then OLLAMA_UP=true; break; fi
        sleep 1
    done
    if [ "$OLLAMA_UP" = true ] && [ -x "$PROJECT_DIR/backend/.venv/bin/python" ]; then
        echo -e "${YELLOW}[*] Checking the chat model is fully on the GPU (background)...${NC}"
        (
            cd "$PROJECT_DIR/backend"
            nohup .venv/bin/python scripts/ollama_gpu_guard.py >> "$PROJECT_DIR/.logs/gpu_guard.log" 2>&1 &
        )
        echo -e "${GREEN}[✓] GPU guard running; result in .logs/gpu_guard.log${NC}"
    else
        echo -e "${YELLOW}[!] Ollama not reachable at $OLLAMA_URL; skipping GPU guard.${NC}"
    fi
fi

# 2c. HSN master: backend/data is git-ignored, so (re)build it when missing or still on the pre-hierarchy schema.
HSN_DB="$PROJECT_DIR/backend/data/hsn_master.db"
if [ -x "$PROJECT_DIR/backend/.venv/bin/python" ] && [ -f "$PROJECT_DIR/HSN_SAC.xlsx" ] && \
   ! "$PROJECT_DIR/backend/.venv/bin/python" -c "import sqlite3,sys; c=sqlite3.connect(sys.argv[1]); sys.exit(0 if any(r[1]=='is_group' for r in c.execute('pragma table_info(hsn_codes)')) else 1)" "$HSN_DB" 2>/dev/null; then
    echo -e "${YELLOW}[*] Building the HSN master database (missing or old schema)...${NC}"
    (cd "$PROJECT_DIR/backend" && .venv/bin/python scripts/build_hsn_database.py > "$PROJECT_DIR/.logs/hsn_build.log" 2>&1) \
        && echo -e "${GREEN}[✓] HSN master built.${NC}" \
        || echo -e "${RED}[!] HSN build failed; see .logs/hsn_build.log${NC}"
fi

# 3. Backend Service (Port 8011)
BACKEND_PID_FILE="$PROJECT_DIR/.pids/backend.pid"
BACKEND_RUNNING=false

if [ -f "$BACKEND_PID_FILE" ] && kill -0 "$(cat "$BACKEND_PID_FILE")" 2>/dev/null; then
    BACKEND_RUNNING=true
elif lsof -ti :8011 &>/dev/null; then
    BACKEND_RUNNING=true
fi

if [ "$BACKEND_RUNNING" = true ]; then
    echo -e "${GREEN}[✓] Backend is already running on port 8011.${NC}"
else
    echo -e "${YELLOW}[*] Starting Backend service on http://127.0.0.1:8011...${NC}"
    VENV_PYTHON="$PROJECT_DIR/backend/.venv/bin/python"
    VENV_UVICORN="$PROJECT_DIR/backend/.venv/bin/uvicorn"

    if [ ! -x "$VENV_UVICORN" ]; then
        echo -e "${YELLOW}[*] Creating Python virtual environment in backend/.venv...${NC}"
        python3 -m venv "$PROJECT_DIR/backend/.venv"
        "$PROJECT_DIR/backend/.venv/bin/pip" install -r "$PROJECT_DIR/backend/requirements.txt"
    fi

    BACKEND_LOG="$PROJECT_DIR/.logs/backend.log"
    # Append, never truncate: the migration output below and earlier runs'
    # tracebacks must survive the server start.
    echo "===== backend start $(date '+%Y-%m-%d %H:%M:%S') =====" >> "$BACKEND_LOG"

    # Run database migrations
    if [ -x "$PROJECT_DIR/backend/.venv/bin/alembic" ]; then
        echo -e "${YELLOW}[*] Applying database migrations...${NC}"
        if ! (cd "$PROJECT_DIR/backend" && .venv/bin/alembic upgrade head >> "$BACKEND_LOG" 2>&1); then
            echo -e "${RED}[!] Database migration failed -- see $BACKEND_LOG${NC}"
        fi
    fi

    (
        cd "$PROJECT_DIR/backend"
        # X-Forwarded-For is honoured only from the addresses in FORWARDED_ALLOW_IPS (comma
        # separated reverse-proxy IPs). Empty (default) trusts nobody, so a client cannot
        # spoof its address to dodge the rate limits.
        nohup "$VENV_UVICORN" app:app --reload --port 8011 \
            --forwarded-allow-ips "${FORWARDED_ALLOW_IPS:-}" >> "$BACKEND_LOG" 2>&1 &
        echo $! > "$BACKEND_PID_FILE"
    )
    echo -e "${GREEN}[✓] Backend service started (PID: $(cat "$BACKEND_PID_FILE")).${NC}"
fi

# 3. Frontend Service (Port 5175)
FRONTEND_PID_FILE="$PROJECT_DIR/.pids/frontend.pid"
FRONTEND_RUNNING=false

if [ -f "$FRONTEND_PID_FILE" ] && kill -0 "$(cat "$FRONTEND_PID_FILE")" 2>/dev/null; then
    FRONTEND_RUNNING=true
elif lsof -ti :5175 &>/dev/null; then
    FRONTEND_RUNNING=true
fi

if [ "$FRONTEND_RUNNING" = true ]; then
    echo -e "${GREEN}[✓] Frontend is already running on port 5175.${NC}"
else
    echo -e "${YELLOW}[*] Starting Frontend service on http://localhost:5175...${NC}"
    if [ ! -d "$PROJECT_DIR/frontend/node_modules" ]; then
        echo -e "${YELLOW}[*] Installing frontend dependencies (npm install)...${NC}"
        (cd "$PROJECT_DIR/frontend" && npm install >> "$PROJECT_DIR/.logs/frontend.log" 2>&1)
    fi

    (
        cd "$PROJECT_DIR/frontend"
        nohup npm run dev > "$PROJECT_DIR/.logs/frontend.log" 2>&1 &
        echo $! > "$FRONTEND_PID_FILE"
    )
    echo -e "${GREEN}[✓] Frontend service started (PID: $(cat "$FRONTEND_PID_FILE")).${NC}"
fi

# 4. Wait briefly and report status
echo -e "${YELLOW}[*] Verifying services...${NC}"
sleep 2

echo -e "\n${BLUE}====================================================${NC}"
echo -e "${GREEN}        Services Started & Ready to Use!            ${NC}"
echo -e "${BLUE}====================================================${NC}"
echo -e "  Frontend URL:     ${GREEN}http://localhost:5175${NC}"
echo -e "  Backend API:      ${GREEN}http://127.0.0.1:8011${NC}"
echo -e "  vLLM Engine:      ${GREEN}http://127.0.0.1:8001/v1${NC}"
echo -e "  API Docs (Swagger):${GREEN}http://127.0.0.1:8011/docs${NC}"
echo -e "  API Health Check: ${GREEN}http://127.0.0.1:8011/api/v1/health${NC}"
echo -e "  Backend Log:      $PROJECT_DIR/.logs/backend.log"
echo -e "  Frontend Log:     $PROJECT_DIR/.logs/frontend.log"
echo -e "${BLUE}====================================================${NC}\n"

# Desktop notification if supported
if command -v notify-send &>/dev/null && { [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; }; then
    notify-send "B2B Marketplace" "Services started successfully!\nFrontend: http://localhost:5175\nBackend: http://127.0.0.1:8011" 2>/dev/null || true
fi

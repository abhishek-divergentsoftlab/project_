# Copy to .env and edit. Never commit .env.

PROJECT_NAME="B2B Marketplace API"
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Must match docker-compose.yml credentials.
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5433/marketplace

# Reserved for phase 4+ (not read yet).
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=Qwen/Qwen3-8B
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=gpt-oss:120b
# Optional model assist for direct search. Off by default; the parser is more
# accurate on prices, quantities and dates, and has no latency.
DIRECT_SEARCH_LLM=false
# Must equal the num_ctx of every other caller of the same Ollama model, or Ollama reloads it (0 = server default)
AI_CHAT_NUM_CTX=0
IMAGE_MODERATION_MODEL=qwen3-vl:8b
IMAGE_MODERATION_ENABLED=true

HOST=127.0.0.1
PORT=8011

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Optional Map & Geocoding API keys (defaults to local gazetteer and Nominatim)
# Mapbox: https://account.mapbox.com/ (Free: 50,000 map loads & 100k geocodes/mo)
MAPBOX_ACCESS_TOKEN=
# Geoapify / LocationIQ API key
GEOCODING_API_KEY=
# 0 = run the embedding model on CPU so it cannot evict the chat model from a shared GPU
EMBEDDING_NUM_GPU=-1

# Comma-separated emails allowed to use the /ops endpoints (KYC, certificates, escrow deposits, suspensions).
OPERATOR_EMAILS=

# --- Security (WP1) ---
# Failed logins per email from any address, and per-user limits on expensive endpoints ("<count>/<seconds>").
RATE_LIMIT_LOGIN_EMAIL=20/900
RATE_LIMIT_AI_CHAT=20/60
RATE_LIMIT_TRANSLATE=30/60
RATE_LIMIT_RFQ_WRITE=30/300
RATE_LIMIT_LIVE_CAPTURE=30/600
RATE_LIMIT_SUGGEST=30/300
# Must match the QDRANT_API_KEY / REDIS_PASSWORD given to docker compose.
QDRANT_API_KEY=
# Proxy addresses uvicorn trusts for X-Forwarded-For (start.sh reads FORWARDED_ALLOW_IPS; empty = trust nobody).
# FORWARDED_ALLOW_IPS=
# The built-in dev SECRET_KEY is refused unless HOST is loopback.
